          "position": {"x": 0, "y": 0, "width": 12, "height": 1}
        },
        {
          "widget": {
            "name": "times-age-gender-chart",
            "queries": [{"name": "main_query", "query": {"datasetName": "times_metrics", "fields": [{"name": "age_group", "expression": "`age_group`"}, {"name": "gender", "expression": "`gender`"}, {"name": "mean_time_min", "expression": "AVG(`mean_time_min`)"}], "disaggregated": false}}],
            "spec": {"version": 3, "widgetType": "bar", "encodings": {"x": {"fieldName": "age_group", "scale": {"type": "categorical"}, "displayName": "Faixa etaria"}, "y": {"fieldName": "mean_time_min", "scale": {"type": "quantitative"}, "displayName": "Tempo medio (min)"}, "color": {"fieldName": "gender", "scale": {"type": "categorical"}, "displayName": "Genero"}}, "mark": {"layout": "group"}, "frame": {"title": "Tempo medio por idade e genero", "showTitle": true}}
          },
          "position": {"x": 0, "y": 1, "width": 7, "height": 6}
        },
        {
          "widget": {
            "name": "times-statistics-table",
            "queries": [{"name": "main_query", "query": {"datasetName": "times_metrics", "fields": [{"name": "source", "expression": "`source`"}, {"name": "year", "expression": "`year`"}, {"name": "gender", "expression": "`gender`"}, {"name": "age_group", "expression": "`age_group`"}, {"name": "min_time_hm", "expression": "`min_time_hm`"}, {"name": "q1_time_hm", "expression": "`q1_time_hm`"}, {"name": "median_time_hm", "expression": "`median_time_hm`"}, {"name": "mean_time_hm", "expression": "`mean_time_hm`"}, {"name": "q3_time_hm", "expression": "`q3_time_hm`"}, {"name": "max_time_hm", "expression": "`max_time_hm`"}], "disaggregated": true}}],
            "spec": {"version": 2, "widgetType": "table", "encodings": {"columns": [{"fieldName": "source", "displayName": "Maratona"}, {"fieldName": "year", "displayName": "Ano"}, {"fieldName": "gender", "displayName": "Genero"}, {"fieldName": "age_group", "displayName": "Faixa"}, {"fieldName": "min_time_hm", "displayName": "Min (HH:MM)"}, {"fieldName": "q1_time_hm", "displayName": "Q1 (HH:MM)"}, {"fieldName": "median_time_hm", "displayName": "Mediana (HH:MM)"}, {"fieldName": "mean_time_hm", "displayName": "Media (HH:MM)"}, {"fieldName": "q3_time_hm", "displayName": "Q3 (HH:MM)"}, {"fieldName": "max_time_hm", "displayName": "Max (HH:MM)"}]}, "frame": {"title": "Estatisticas por grupo", "showTitle": true}}
          },
          "position": {"x": 7, "y": 1, "width": 5, "height": 6}
        }
      ]
    },
    {
      "name": "comparison-page",
      "displayName": "Comparacao",
