            "spec": {"version": 3, "widgetType": "bar", "encodings": {"x": {"fieldName": "total_athletes", "scale": {"type": "quantitative"}, "displayName": "Atletas"}, "y": {"fieldName": "country", "scale": {"type": "categorical"}, "displayName": "Pais"}}, "frame": {"title": "Atletas por pais", "showTitle": true}}
          },
          "position": {"x": 0, "y": 1, "width": 7, "height": 7}
        },
        {
          "widget": {
            "name": "country-performance-table",
            "queries": [{"name": "main_query", "query": {"datasetName": "country_performance", "fields": [{"name": "country", "expression": "`country`"}, {"name": "total_athletes", "expression": "`total_athletes`"}, {"name": "avg_finish_time_hm", "expression": "`avg_finish_time_hm`"}], "disaggregated": true}}],
            "spec": {"version": 2, "widgetType": "table", "encodings": {"columns": [{"fieldName": "country", "displayName": "Pais"}, {"fieldName": "total_athletes", "displayName": "Atletas"}, {"fieldName": "avg_finish_time_hm", "displayName": "Tempo medio (HH:MM)"}]}, "frame": {"title": "Ranking detalhado", "showTitle": true}}
          },
          "position": {"x": 7, "y": 1, "width": 5, "height": 7}
        }
      ]
    },
    {
