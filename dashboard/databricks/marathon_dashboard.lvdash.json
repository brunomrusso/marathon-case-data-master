            "spec": {"version": 3, "widgetType": "line", "encodings": {"x": {"fieldName": "year", "scale": {"type": "quantitative"}, "displayName": "Ano"}, "y": {"fieldName": "avg_time_min", "scale": {"type": "quantitative"}, "displayName": "Tempo medio (min)"}, "color": {"fieldName": "source", "scale": {"type": "categorical"}, "displayName": "Maratona"}}, "frame": {"title": "Tempo medio por maratona", "showTitle": true}}
