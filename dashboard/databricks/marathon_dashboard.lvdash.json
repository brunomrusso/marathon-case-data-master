            "spec": {"version": 2, "widgetType": "table", "encodings": {"columns": [{"fieldName": "age_group", "displayName": "Faixa etaria"}, {"fieldName": "gender", "displayName": "Genero"}, {"fieldName": "total_athletes", "displayName": "Atletas"}, {"fieldName": "avg_finish_time_hm", "displayName": "Tempo medio (HH:MM)"}]}, "frame": {"title": "Detalhamento demografico", "showTitle": true}}
          },
          "position": {"x": 8, "y": 1, "width": 4, "height": 6}
