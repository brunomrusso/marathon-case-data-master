{
  "datasets": [
    {
      "name": "summary",
      "displayName": "Indicadores gerais",
      "queryLines": [
        "SELECT SUM(total_athletes) AS total_finishers, COUNT(DISTINCT year) AS total_editions, COUNT(DISTINCT source) AS total_marathons, ROUND(AVG(avg_finish_time_sec) / 60, 1) AS avg_finish_time_min, CONCAT(LPAD(CAST(FLOOR(AVG(avg_finish_time_sec) / 3600) AS STRING), 2, '0'), ':', LPAD(CAST(FLOOR(PMOD(AVG(avg_finish_time_sec), 3600) / 60) AS STRING), 2, '0')) AS avg_finish_time_hm FROM marathon.gold.kpi_summary"
      ]
    },
    {
      "name": "finishers_by_year",
      "displayName": "Concluintes por ano e maratona",
      "queryLines": [
        "SELECT year, source, SUM(total_finishers) AS total_finishers FROM marathon.gold.finishers_by_year GROUP BY year, source ORDER BY year, source"
      ]
    },
    {
      "name": "top_countries",
      "displayName": "Principais paises",
      "queryLines": [
        "SELECT country, SUM(total_athletes) AS total_athletes FROM marathon.gold.top_countries WHERE country IS NOT NULL GROUP BY country ORDER BY total_athletes DESC LIMIT 20"
      ]
    },
    {
      "name": "demographics",
      "displayName": "Perfil demografico",
      "queryLines": [
        "SELECT age_group, gender, SUM(total_athletes) AS total_athletes, ROUND(AVG(avg_finish_time_sec) / 60, 1) AS avg_finish_time_min, CONCAT(LPAD(CAST(FLOOR(AVG(avg_finish_time_sec) / 3600) AS STRING), 2, '0'), ':', LPAD(CAST(FLOOR(PMOD(AVG(avg_finish_time_sec), 3600) / 60) AS STRING), 2, '0')) AS avg_finish_time_hm FROM marathon.gold.age_gender_profile WHERE age_group IS NOT NULL GROUP BY age_group, gender ORDER BY CASE WHEN age_group = '0-17' THEN 0 WHEN age_group = '18-39' THEN 18 ELSE CAST(SPLIT(age_group, '-')[0] AS INT) END, gender"
      ]
    },
    {
      "name": "weather",
      "displayName": "Clima e performance",
      "queryLines": [
        "SELECT source, year, temperature_mean_c, precipitation_mm, ROUND(avg_finish_time_sec / 60, 1) AS avg_finish_time_min FROM marathon.gold.weather_impact WHERE temperature_mean_c IS NOT NULL ORDER BY year, source"
      ]
    },
    {
      "name": "country_performance",
      "displayName": "Performance por pais",
      "queryLines": [
        "SELECT country, total_athletes, ROUND(avg_finish_time_sec / 60, 1) AS avg_finish_time_min, CONCAT(LPAD(CAST(FLOOR(avg_finish_time_sec / 3600) AS STRING), 2, '0'), ':', LPAD(CAST(FLOOR(PMOD(avg_finish_time_sec, 3600) / 60) AS STRING), 2, '0')) AS avg_finish_time_hm FROM marathon.gold.athletes_by_country WHERE country IS NOT NULL ORDER BY total_athletes DESC LIMIT 30"
      ]
    },
    {
      "name": "times_metrics",
      "displayName": "Distribuicao de tempos",
      "queryLines": [
        "SELECT source, year, gender, age_group, ROUND(mean / 60, 1) AS mean_time_min, CONCAT(LPAD(CAST(FLOOR(min / 3600) AS STRING), 2, '0'), ':', LPAD(CAST(FLOOR(PMOD(min, 3600) / 60) AS STRING), 2, '0')) AS min_time_hm, CONCAT(LPAD(CAST(FLOOR(q1 / 3600) AS STRING), 2, '0'), ':', LPAD(CAST(FLOOR(PMOD(q1, 3600) / 60) AS STRING), 2, '0')) AS q1_time_hm, CONCAT(LPAD(CAST(FLOOR(median / 3600) AS STRING), 2, '0'), ':', LPAD(CAST(FLOOR(PMOD(median, 3600) / 60) AS STRING), 2, '0')) AS median_time_hm, CONCAT(LPAD(CAST(FLOOR(mean / 3600) AS STRING), 2, '0'), ':', LPAD(CAST(FLOOR(PMOD(mean, 3600) / 60) AS STRING), 2, '0')) AS mean_time_hm, CONCAT(LPAD(CAST(FLOOR(q3 / 3600) AS STRING), 2, '0'), ':', LPAD(CAST(FLOOR(PMOD(q3, 3600) / 60) AS STRING), 2, '0')) AS q3_time_hm, CONCAT(LPAD(CAST(FLOOR(max / 3600) AS STRING), 2, '0'), ':', LPAD(CAST(FLOOR(PMOD(max, 3600) / 60) AS STRING), 2, '0')) AS max_time_hm FROM marathon.gold.times_distribution WHERE age_group IS NOT NULL"
      ]
    },
    {
      "name": "marathon_comparison",
      "displayName": "Comparacao entre maratonas",
      "queryLines": [
        "SELECT year, 'Berlin' AS source, berlin_finishers AS finishers, ROUND(berlin_avg_time / 60, 1) AS avg_time_min FROM marathon.gold.marathon_comparison WHERE berlin_finishers IS NOT NULL UNION ALL SELECT year, 'Chicago', chicago_finishers, ROUND(chicago_avg_time / 60, 1) FROM marathon.gold.marathon_comparison WHERE chicago_finishers IS NOT NULL UNION ALL SELECT year, 'London', london_finishers, ROUND(london_avg_time / 60, 1) FROM marathon.gold.marathon_comparison WHERE london_finishers IS NOT NULL UNION ALL SELECT year, 'New York', nyc_finishers, ROUND(nyc_avg_time / 60, 1) FROM marathon.gold.marathon_comparison WHERE nyc_finishers IS NOT NULL ORDER BY year, source"
      ]
    },
    {
      "name": "quality",
      "displayName": "Qualidade e observabilidade",
      "queryLines": [
        "SELECT recorded_at, layer, step, status, row_count_in, row_count_out, rejected_records, schema_drift_flag, execution_time_sec, run_id, batch_id FROM marathon.monitoring.data_quality_log ORDER BY recorded_at DESC LIMIT 100"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Visao Geral",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {"name": "overview-title", "multilineTextboxSpec": {"lines": ["## World Marathon Majors"]}},
          "position": {"x": 0, "y": 0, "width": 12, "height": 1}
        },
        {
          "widget": {"name": "overview-subtitle", "multilineTextboxSpec": {"lines": ["Berlin, Chicago, London e New York — indicadores consolidados da camada Gold"]}},
          "position": {"x": 0, "y": 1, "width": 12, "height": 1}
        },
        {
          "widget": {
            "name": "total-finishers",
            "queries": [{"name": "main_query", "query": {"datasetName": "summary", "fields": [{"name": "total_finishers", "expression": "`total_finishers`"}], "disaggregated": true}}],
            "spec": {"version": 2, "widgetType": "counter", "encodings": {"value": {"fieldName": "total_finishers", "displayName": "Concluintes", "format": {"type": "number", "abbreviation": "compact"}}}, "frame": {"title": "Total de concluintes", "showTitle": true}}
          },
          "position": {"x": 0, "y": 2, "width": 3, "height": 3}
        },
        {
          "widget": {
            "name": "total-editions",
            "queries": [{"name": "main_query", "query": {"datasetName": "summary", "fields": [{"name": "total_editions", "expression": "`total_editions`"}], "disaggregated": true}}],
            "spec": {"version": 2, "widgetType": "counter", "encodings": {"value": {"fieldName": "total_editions", "displayName": "Edicoes"}}, "frame": {"title": "Edicoes analisadas", "showTitle": true}}
          },
          "position": {"x": 3, "y": 2, "width": 3, "height": 3}
        },
        {
          "widget": {
            "name": "total-marathons",
            "queries": [{"name": "main_query", "query": {"datasetName": "summary", "fields": [{"name": "total_marathons", "expression": "`total_marathons`"}], "disaggregated": true}}],
            "spec": {"version": 2, "widgetType": "counter", "encodings": {"value": {"fieldName": "total_marathons", "displayName": "Maratonas"}}, "frame": {"title": "Maratonas", "showTitle": true}}
          },
          "position": {"x": 6, "y": 2, "width": 3, "height": 3}
        },
        {
          "widget": {
            "name": "average-time",
            "queries": [{"name": "main_query", "query": {"datasetName": "summary", "fields": [{"name": "avg_finish_time_hm", "expression": "`avg_finish_time_hm`"}], "disaggregated": true}}],
            "spec": {"version": 2, "widgetType": "counter", "encodings": {"value": {"fieldName": "avg_finish_time_hm", "displayName": "HH:MM"}}, "frame": {"title": "Tempo medio (HH:MM)", "showTitle": true}}
          },
          "position": {"x": 9, "y": 2, "width": 3, "height": 3}
        },
        {
          "widget": {
            "name": "finishers-trend",
            "queries": [{"name": "main_query", "query": {"datasetName": "finishers_by_year", "fields": [{"name": "year", "expression": "`year`"}, {"name": "source", "expression": "`source`"}, {"name": "total_finishers", "expression": "`total_finishers`"}], "disaggregated": true}}],
            "spec": {"version": 3, "widgetType": "line", "encodings": {"x": {"fieldName": "year", "scale": {"type": "quantitative"}, "displayName": "Ano"}, "y": {"fieldName": "total_finishers", "scale": {"type": "quantitative"}, "displayName": "Concluintes"}, "color": {"fieldName": "source", "scale": {"type": "categorical"}, "displayName": "Maratona"}}, "frame": {"title": "Evolucao de concluintes", "showTitle": true}}
          },
          "position": {"x": 0, "y": 5, "width": 8, "height": 6}
        },
        {
          "widget": {
            "name": "countries-ranking",
            "queries": [{"name": "main_query", "query": {"datasetName": "top_countries", "fields": [{"name": "country", "expression": "`country`"}, {"name": "total_athletes", "expression": "`total_athletes`"}], "disaggregated": true}}],
            "spec": {"version": 3, "widgetType": "bar", "encodings": {"x": {"fieldName": "total_athletes", "scale": {"type": "quantitative"}, "displayName": "Atletas"}, "y": {"fieldName": "country", "scale": {"type": "categorical"}, "displayName": "Pais"}}, "frame": {"title": "Top 20 paises", "showTitle": true}}
          },
          "position": {"x": 8, "y": 5, "width": 4, "height": 6}
        }
      ]
    },
    {
      "name": "demographics-page",
      "displayName": "Demografia",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {"name": "demographics-title", "multilineTextboxSpec": {"lines": ["## Perfil por faixa etaria e genero"]}},
          "position": {"x": 0, "y": 0, "width": 12, "height": 1}
