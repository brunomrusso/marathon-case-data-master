        {
          "widget": {
            "name": "age-gender-chart",
            "queries": [{"name": "main_query", "query": {"datasetName": "demographics", "fields": [{"name": "age_group", "expression": "`age_group`"}, {"name": "gender", "expression": "`gender`"}, {"name": "total_athletes", "expression": "`total_athletes`"}], "disaggregated": true}}],
            "spec": {"version": 3, "widgetType": "bar", "encodings": {"x": {"fieldName": "age_group", "scale": {"type": "categorical"}, "displayName": "Faixa etaria"}, "y": {"fieldName": "total_athletes", "scale": {"type": "quantitative"}, "displayName": "Atletas"}, "color": {"fieldName": "gender", "scale": {"type": "categorical"}, "displayName": "Genero"}}, "mark": {"layout": "group"}, "frame": {"title": "Atletas por faixa etaria", "showTitle": true}}
