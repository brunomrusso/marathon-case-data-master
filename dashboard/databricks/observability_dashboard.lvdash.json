                      "expression": "total_execution_time_sec"
                    },
                    {
                      "name": "has_failure",
                      "expression": "has_failure"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {
                    "fieldName": "run_id",
                    "displayName": "Run ID"
                  },
                  {
                    "fieldName": "batch_id",
                    "displayName": "Batch ID"
                  },
                  {
                    "fieldName": "recorded_at",
                    "displayName": "Registrado em"
                  },
                  {
                    "fieldName": "total_execution_time_sec",
                    "displayName": "Tempo total (s)"
                  },
                  {
                    "fieldName": "has_failure",
                    "displayName": "Falha"
                  }
                ]
              },
              "options": {
                "title": "Histórico de execuções"
