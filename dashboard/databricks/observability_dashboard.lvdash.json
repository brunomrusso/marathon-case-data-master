                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "step",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Etapa"
                },
                "y": {
                  "fieldName": "execution_time_sec",
                  "scale": {
                    "type": "quantitative"
                  },
                  "aggregation": "AVG",
                  "displayName": "Tempo médio (s)"
                }
              },
              "frame": {
                "title": "Tempo médio de execução por etapa",
                "showTitle": true
