{
  "datasets": [
    {
      "name": "pipeline_runs",
      "displayName": "Execuções do pipeline",
      "queryLines": [
        "SELECT run_id, batch_id, MAX(recorded_at) AS recorded_at, SUM(execution_time_sec) AS total_execution_time_sec, MAX(CASE WHEN status IN ('FAIL', 'ERROR') THEN 1 ELSE 0 END) AS has_failure FROM data_quality_log GROUP BY run_id, batch_id ORDER BY recorded_at DESC"
      ]
    },
    {
      "name": "quality_metrics",
      "displayName": "Métricas de qualidade",
      "queryLines": [
        "SELECT layer, step, source, year, row_count_in, row_count_out, rejected_records, schema_drift_flag, execution_time_sec, status, recorded_at FROM data_quality_log ORDER BY recorded_at DESC"
      ]
    },
    {
      "name": "rejected_bronze",
      "displayName": "Rejeitados — bronze_orchestrator",
      "queryLines": [
        "SELECT COALESCE(SUM(rejected_records), 0) AS rejected_records FROM data_quality_log WHERE step = 'bronze_orchestrator'"
      ]
    },
    {
      "name": "rejected_silver",
      "displayName": "Rejeitados — silver_etl",
      "queryLines": [
        "SELECT COALESCE(SUM(rejected_records), 0) AS rejected_records FROM data_quality_log WHERE step = 'silver_etl'"
      ]
    },
    {
      "name": "rejected_weather",
      "displayName": "Rejeitados — weather_enrichment",
      "queryLines": [
        "SELECT COALESCE(SUM(rejected_records), 0) AS rejected_records FROM data_quality_log WHERE step = 'weather_enrichment'"
      ]
    },
    {
      "name": "rejected_gold",
      "displayName": "Rejeitados — gold_aggregations",
      "queryLines": [
        "SELECT COALESCE(SUM(rejected_records), 0) AS rejected_records FROM data_quality_log WHERE step = 'gold_aggregations'"
      ]
    },
    {
      "name": "rejected_governance",
      "displayName": "Rejeitados — masked_pii_views",
      "queryLines": [
        "SELECT COALESCE(SUM(rejected_records), 0) AS rejected_records FROM data_quality_log WHERE step = 'masked_pii_views'"
      ]
    },
    {
      "name": "schema_drift_count",
      "displayName": "Alertas de schema drift",
      "queryLines": [
        "SELECT COUNT_IF(schema_drift_flag) AS schema_drift_count FROM data_quality_log"
      ]
    }
  ],
  "pages": [
    {
      "name": "observability-page",
      "displayName": "Observabilidade",
      "pageType": "PAGE_TYPE_REPORT",
      "layout": [
        {
          "widget": {
            "name": "obs-kpi-latest-status",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "pipeline_runs",
                  "fields": [
                    {
                      "name": "has_failure",
                      "expression": "has_failure"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "has_failure"
                }
              },
              "frame": {
                "title": "Última execução falhou?",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 2,
            "height": 4
          }
        },
        {
          "widget": {
            "name": "obs-pipeline-runs-table",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "pipeline_runs",
                  "fields": [
                    {
                      "name": "run_id",
