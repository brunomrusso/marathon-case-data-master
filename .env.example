# Configuracoes do projeto marathon-case-data-master
# Copie este arquivo para .env e preencha os valores obrigatorios.

# Azure
# SUBSCRIPTION_ID=opcional-se-ja-estiver-logado-no-az-cli

# Databricks (host sera descoberto automaticamente apos o deploy do Bicep,
# mas o token precisa ser gerado manualmente no workspace)
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Opcional: email para alertas de falha no workflow
ALERT_EMAIL=

# Opcional: caminho do repositorio no Databricks Repos
# Exemplo: /Workspace/Repos/seu.usuario@email.com/marathon-case-data-master
DATABRICKS_REPO_PATH=

# Opcional: ID de um cluster existente para reusar no workflow
# DATABRICKS_EXISTING_CLUSTER_ID=

# Opcional: tipo de trigger (file_arrival ou schedule)
TRIGGER_TYPE=file_arrival
